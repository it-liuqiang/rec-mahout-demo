<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rec.mapper.ItemsMapper">

    <resultMap id="BaseResultMap" type="com.example.rec.domain.Items">
            <id property="itemId" column="item_id" jdbcType="VARCHAR"/>
            <result property="isHidden" column="is_hidden" jdbcType="BOOLEAN"/>
            <result property="categories" column="categories" jdbcType="VARCHAR"/>
            <result property="timeStamp" column="time_stamp" jdbcType="TIMESTAMP"/>
            <result property="labels" column="labels" jdbcType="VARCHAR"/>
            <result property="comment" column="comment" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        item_id,is_hidden,categories,
        time_stamp,labels,comment
    </sql>

    <resultMap id="ItemTagAndUsersResultMap" type="com.example.rec.model.ItemTagUsersDTO">
        <id property="itemId" column="item_id" jdbcType="VARCHAR"/>
        <result property="tags" column="labels" jdbcType="VARCHAR"/>
        <collection property="interactedUsers" ofType="java.lang.String" column="user_id">
            <result column="user_id" jdbcType="VARCHAR"/>
        </collection>
    </resultMap>

    <select id="getItemTagAndUsers" resultMap="ItemTagAndUsersResultMap">
        SELECT
            i.item_id,
            i.labels,
            f.user_id
        FROM
            items i
                LEFT JOIN feedback f ON i.item_id = f.item_id
        WHERE
            f.feedback_type = 'buy' and f.time_stamp >= NOW() - INTERVAL ${popularWindow}
    </select>


</mapper>
