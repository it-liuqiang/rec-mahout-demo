<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rec.mapper.UsersMapper">

    <resultMap id="BaseResultMap" type="com.example.rec.domain.Users">
            <id property="userId" column="user_id" jdbcType="VARCHAR"/>
            <result property="labels" column="labels" jdbcType="OTHER"/>
            <result property="subscribe" column="subscribe" jdbcType="OTHER"/>
            <result property="comment" column="comment" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        user_id,labels,subscribe,
        comment
    </sql>


    <resultMap id="UserTagAndItemsResultMap" type="com.example.rec.model.UserTagItemDTO">
        <id property="userId" column="user_id" jdbcType="VARCHAR"/>
        <result property="tags" column="labels" jdbcType="VARCHAR"/>
        <collection property="items" ofType="java.lang.String" column="item_id">
            <result column="item_id" jdbcType="VARCHAR"/>
        </collection>
    </resultMap>


    <select id="getUserTagAndItems" resultMap="UserTagAndItemsResultMap">
        SELECT
            u.user_id,
            u.labels,
            f.item_id
        FROM
            users u
                LEFT JOIN feedback f ON u.user_id = f.user_id
        WHERE
            f.feedback_type = 'buy' and f.time_stamp >= NOW() - INTERVAL ${popularWindow}
    </select>
</mapper>
